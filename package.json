{
  "name": "spot-price",
  "version": "0.1.0",
  "description": "Finnish spot electricity price API with total price calculation and cheapest window finder",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup && pnpm copy:migrations",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "bash ./scripts/smoke-local.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx e2e/global-setup.ts && playwright test",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "seed": "tsx --env-file=.env src/seed.ts",
    "backtest": "tsx --env-file=.env tools/backtest-cli.ts",
    "revision-magnitude": "tsx --env-file=.env tools/revision-magnitude-cli.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "copy:migrations": "mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.10.16",
    "better-auth": "^1.6.11",
    "hono": "^4.12.19",
    "hono-rate-limiter": "^0.5.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
