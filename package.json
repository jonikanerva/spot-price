{
  "name": "spot-price",
  "version": "0.1.0",
  "description": "Finnish spot electricity price API with total price calculation and cheapest window finder",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && npm run copy:migrations",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "bash ./scripts/smoke-local.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "copy:migrations": "mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-auth": "^1.4.19",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.7.0",
    "hono-rate-limiter": "^0.5.3",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.19",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
