{
  "openapi": "3.1.0",
  "info": {
    "title": "Spot Price API",
    "version": "1.0.0",
    "description": "Finnish and Nordic spot electricity price API with total price calculation, cheapest window finder, and per-user contract settings."
  },
  "servers": [{ "url": "https://spot.calmdonut.com" }],
  "security": [{ "BearerAuth": [] }],
  "tags": [
    {
      "name": "Price",
      "description": "Electricity price endpoints (API key required)"
    },
    {
      "name": "Forecast",
      "description": "FI price forecast — a clearly-labelled estimate, separate from real prices (API key required)"
    },
    {
      "name": "User",
      "description": "User settings and chart data (session required)"
    },
    { "name": "Public", "description": "Unauthenticated endpoints" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key obtained from the web dashboard. Use as: Authorization: Bearer <api-key>"
      }
    },
    "schemas": {
      "PublicSpot": {
        "type": "object",
        "properties": {
          "area": { "type": "string", "example": "FI" },
          "today": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SpotPriceEntry" }
          },
          "tomorrow": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SpotPriceEntry" }
          },
          "tomorrowAvailable": { "type": "boolean", "example": true },
          "unit": { "type": "string", "example": "c/kWh" },
          "resolutionMinutes": { "type": "integer", "example": 15 }
        },
        "required": [
          "area",
          "today",
          "tomorrow",
          "tomorrowAvailable",
          "unit",
          "resolutionMinutes"
        ]
      },
      "SpotPriceEntry": {
        "type": "object",
        "properties": {
          "deliveryStart": {
            "type": "string",
            "example": "2026-02-27T10:00:00.000Z"
          },
          "deliveryEnd": {
            "type": "string",
            "example": "2026-02-27T10:15:00.000Z"
          },
          "priceEurMwh": { "type": "number", "example": 52.3 },
          "area": { "type": "string", "example": "FI" },
          "spotCentsKwh": { "type": "number", "example": 5.23 }
        },
        "required": [
          "deliveryStart",
          "deliveryEnd",
          "priceEurMwh",
          "area",
          "spotCentsKwh"
        ]
      },
      "TotalPrice": {
        "type": "object",
        "properties": {
          "deliveryStart": {
            "type": "string",
            "example": "2026-02-27T10:00:00.000Z"
          },
          "deliveryEnd": {
            "type": "string",
            "example": "2026-02-27T10:15:00.000Z"
          },
          "localStart": {
            "type": "string",
            "example": "2026-02-27T12:00:00.000+02:00"
          },
          "localEnd": {
            "type": "string",
            "example": "2026-02-27T12:15:00.000+02:00"
          },
          "spotCentsKwh": { "type": "number", "example": 5.23 },
          "marginCentsKwh": { "type": "number", "example": 0.5 },
          "transferCentsKwh": { "type": "number", "example": 2.5 },
          "taxCentsKwh": { "type": "number", "example": 2.79372 },
          "vatCentsKwh": { "type": "number", "example": 2.81 },
          "totalCentsKwh": {
            "type": "number",
            "example": 13.83,
            "description": "Total price (c/kWh) the household pays. Floored at the contract-cost minimum: negative spot is treated as 0 (a retailer does not credit negatives), so the total never drops below (margin + transfer + tax) × (1 + VAT). The displayed spotCentsKwh stays raw and may be negative."
          },
          "isNightRate": { "type": "boolean", "example": false }
        },
        "required": [
          "deliveryStart",
          "deliveryEnd",
          "localStart",
          "localEnd",
          "spotCentsKwh",
          "marginCentsKwh",
          "transferCentsKwh",
          "taxCentsKwh",
          "vatCentsKwh",
          "totalCentsKwh",
          "isNightRate"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Description of what went wrong"
          }
        },
        "required": ["error"]
      },
      "PriceList": {
        "allOf": [
          { "$ref": "#/components/schemas/PriceWindow" },
          {
            "type": "object",
            "properties": {
              "available": { "type": "boolean", "example": true },
              "expectedAt": { "type": "string", "example": "12:00 UTC" }
            },
            "required": ["available"]
          }
        ]
      },
      "PriceWindow": {
        "type": "object",
        "properties": {
          "start": { "type": "string", "example": "2026-02-27T22:00:00.000Z" },
          "end": { "type": "string", "example": "2026-02-28T01:00:00.000Z" },
          "startLocal": {
            "type": "string",
            "example": "2026-02-28T00:00:00.000+02:00"
          },
          "endLocal": {
            "type": "string",
            "example": "2026-02-28T03:00:00.000+02:00"
          },
          "minTotalCentsKwh": { "type": "number", "example": 6.21 },
          "maxTotalCentsKwh": { "type": "number", "example": 11.05 },
          "averageTotalCentsKwh": { "type": "number", "example": 8.42 },
          "prices": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TotalPrice" }
          }
        },
        "required": [
          "start",
          "end",
          "startLocal",
          "endLocal",
          "minTotalCentsKwh",
          "maxTotalCentsKwh",
          "averageTotalCentsKwh",
          "prices"
        ]
      },
      "ForecastResponse": {
        "type": "object",
        "properties": {
          "forecast": { "type": "boolean", "enum": [true], "example": true },
          "area": { "type": "string", "example": "FI" },
          "available": { "type": "boolean", "example": true },
          "degraded": { "type": "boolean", "example": false },
          "confidence": {
            "type": "string",
            "enum": ["normal", "low"],
            "example": "normal"
          },
          "reason": {
            "type": "string",
            "example": "Forecast available for FI only",
            "description": "Present when available is false or degraded is true"
          },
          "generatedAt": {
            "type": "string",
            "example": "2026-02-28T13:00:00.000Z"
          },
          "unit": { "type": "string", "example": "c/kWh" },
          "resolutionMinutes": { "type": "integer", "example": 15 },
          "bands": { "$ref": "#/components/schemas/ForecastBands" },
          "entries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ForecastEntry" }
          }
        },
        "required": [
          "forecast",
          "area",
          "available",
          "degraded",
          "confidence",
          "generatedAt",
          "unit",
          "resolutionMinutes",
          "entries"
        ]
      },
      "ForecastBands": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["empirical-residual"],
            "example": "empirical-residual"
          },
          "nominalCoverage": {
            "type": "number",
            "example": 0.8,
            "description": "Target fraction the P10/P90 offsets aim to contain."
          },
          "observedCoverage": {
            "type": ["number", "null"],
            "example": null,
            "description": "Measured out-of-sample coverage of the shipped offsets, or null when uncalibrated."
          },
          "calibrated": {
            "type": "boolean",
            "example": false,
            "description": "When false, bands are dark (no bound fields emitted) — coverage did not clear the ship gate or history is too thin."
          },
          "generatedAt": {
            "type": "string",
            "example": "",
            "description": "When the band artifact was generated, or empty when dark."
          }
        },
        "required": [
          "method",
          "nominalCoverage",
          "observedCoverage",
          "calibrated",
          "generatedAt"
        ],
        "description": "Empirical prediction-band descriptor. An estimate of recent residual spread, NOT a guaranteed coverage probability — prices can fall outside it, especially at spikes. Currently ships dark (calibrated:false) until a regenerated artifact clears the coverage gate."
      },
      "ForecastEntry": {
        "type": "object",
        "properties": {
          "start": { "type": "string", "example": "2026-02-28T22:00:00.000Z" },
          "end": { "type": "string", "example": "2026-02-28T22:15:00.000Z" },
          "localStart": {
            "type": "string",
            "example": "2026-03-01T00:00:00.000+02:00"
          },
          "localEnd": {
            "type": "string",
            "example": "2026-03-01T00:15:00.000+02:00"
          },
          "estimatedSpotCentsKwh": { "type": "number", "example": 4.12 },
          "estimatedTotalCentsKwh": {
            "type": "number",
            "example": 11.74,
            "description": "Estimated total price (c/kWh). Floored at the contract-cost minimum: negative spot is treated as 0 (a retailer does not credit negatives), so the total never drops below (margin + transfer + tax) × (1 + VAT). The displayed estimatedSpotCentsKwh stays raw and may be negative."
          },
          "estimatedSpotLowCentsKwh": {
            "type": "number",
            "example": 2.1,
            "description": "Lower empirical band bound (spot). Present only with a calibrated band."
          },
          "estimatedSpotHighCentsKwh": {
            "type": "number",
            "example": 7.8,
            "description": "Upper empirical band bound (spot). Present only with a calibrated band."
          },
          "estimatedTotalLowCentsKwh": {
            "type": "number",
            "example": 9.6,
            "description": "Lower empirical band bound (total, contract terms applied)."
          },
          "estimatedTotalHighCentsKwh": {
            "type": "number",
            "example": 16.3,
            "description": "Upper empirical band bound (total, contract terms applied)."
          }
        },
        "required": [
          "start",
          "end",
          "localStart",
          "localEnd",
          "estimatedSpotCentsKwh",
          "estimatedTotalCentsKwh"
        ]
      },
      "UserSettings": {
        "type": "object",
        "properties": {
          "userId": { "type": "string", "example": "abc123" },
          "marginCentsKwh": { "type": "number", "example": 0.5 },
          "transferDayCentsKwh": { "type": "number", "example": 2.5 },
          "transferNightCentsKwh": { "type": "number", "example": 1.2 },
          "taxCentsKwh": { "type": "number", "example": 2.79372 },
          "vatPercent": { "type": "number", "example": 25.5 },
          "nightStartHour": { "type": "integer", "example": 22 },
          "nightEndHour": { "type": "integer", "example": 7 },
          "timezone": { "type": "string", "example": "Europe/Helsinki" },
          "area": { "type": "string", "example": "FI" }
        },
        "required": [
          "userId",
          "marginCentsKwh",
          "transferDayCentsKwh",
          "transferNightCentsKwh",
          "taxCentsKwh",
          "vatPercent",
          "nightStartHour",
          "nightEndHour",
          "timezone",
          "area"
        ]
      },
      "ChartData": {
        "type": "object",
        "properties": {
          "today": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TotalPrice" }
          },
          "tomorrow": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TotalPrice" }
          },
          "tomorrowAvailable": { "type": "boolean", "example": true },
          "unit": { "type": "string", "example": "c/kWh" },
          "resolutionMinutes": { "type": "integer", "example": 15 }
        },
        "required": [
          "today",
          "tomorrow",
          "tomorrowAvailable",
          "unit",
          "resolutionMinutes"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/public/spot": {
      "get": {
        "tags": ["Public"],
        "summary": "Public spot prices (today + tomorrow)",
        "description": "Returns raw spot prices in c/kWh for the requested delivery area. No authentication required.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "FI",
                "SE1",
                "SE2",
                "SE3",
                "SE4",
                "NO1",
                "NO2",
                "NO3",
                "NO4",
                "NO5",
                "DK1",
                "DK2",
                "EE",
                "LT",
                "LV",
                "AT",
                "BE",
                "FR",
                "GER",
                "NL",
                "PL"
              ],
              "default": "FI",
              "example": "FI",
              "description": "Nord Pool delivery area code"
            },
            "required": false,
            "description": "Nord Pool delivery area code",
            "name": "area",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Spot prices for today and tomorrow (if available)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicSpot" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/now": {
      "get": {
        "tags": ["Price"],
        "summary": "Current total price",
        "description": "Returns the total price breakdown for the current 15-minute delivery interval.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current total price with full breakdown",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TotalPrice" }
              }
            }
          },
          "404": {
            "description": "No current price available or settings not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/today": {
      "get": {
        "tags": ["Price"],
        "summary": "Today's hourly total prices",
        "description": "Returns all total prices for today, calculated with the user's contract settings.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Today's prices",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PriceList" }
              }
            }
          },
          "404": {
            "description": "User settings not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/tomorrow": {
      "get": {
        "tags": ["Price"],
        "summary": "Tomorrow's hourly total prices",
        "description": "Returns tomorrow's total prices if available. Prices are typically published after 12:00 UTC.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Tomorrow's prices (check 'available' field)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PriceList" }
              }
            }
          },
          "404": {
            "description": "User settings not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/cheapest": {
      "get": {
        "tags": ["Price"],
        "summary": "Cheapest contiguous window",
        "description": "Finds the cheapest contiguous N-minute window from available future prices. Optionally constrain the search with startTime, endTime, and maxPrice.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "example": 180,
              "description": "Window duration in minutes (1-1440)"
            },
            "required": true,
            "description": "Window duration in minutes (1-1440)",
            "name": "duration",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "2026-02-27T14:00:00+02:00",
              "description": "Earliest allowed window start (ISO 8601)"
            },
            "required": false,
            "description": "Earliest allowed window start (ISO 8601)",
            "name": "startTime",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "2026-02-28T06:00:00+02:00",
              "description": "Latest allowed window end (ISO 8601)"
            },
            "required": false,
            "description": "Latest allowed window end (ISO 8601)",
            "name": "endTime",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": 12,
              "description": "Maximum allowed total price in c/kWh for each interval in the selected window"
            },
            "required": false,
            "description": "Maximum allowed total price in c/kWh for each interval in the selected window",
            "name": "maxPrice",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Cheapest window with price breakdown per interval",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PriceWindow" }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "No price data available or insufficient data for requested window",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/history": {
      "get": {
        "tags": ["Price"],
        "summary": "Historical total prices for a local date range",
        "description": "Returns all stored total prices for the inclusive local date range [from, to]. Totals apply the user's CURRENT contract settings to the historical public spot prices — there is no historical settings versioning. Dates are YYYY-MM-DD interpreted in the user's timezone; the maximum span is 31 days (inclusive). Check the 'available' field: it is false with an empty 'prices' array when no data is stored for the range.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-04-01",
              "description": "Inclusive range start, YYYY-MM-DD, interpreted in the user's timezone."
            },
            "required": true,
            "description": "Inclusive range start, YYYY-MM-DD, interpreted in the user's timezone.",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-05-01",
              "description": "Inclusive range end, YYYY-MM-DD, interpreted in the user's timezone."
            },
            "required": true,
            "description": "Inclusive range end, YYYY-MM-DD, interpreted in the user's timezone.",
            "name": "to",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Historical prices for the range (check 'available'; false + empty when no data stored)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PriceList" }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters (bad date, from after to, or span over 31 days)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "User settings not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/all": {
      "get": {
        "tags": ["Price"],
        "summary": "All currently-known hourly total prices in one list",
        "description": "Returns every currently-known published total price in a single flat list (today always, tomorrow's intervals appended once Nord Pool has published them), so an automation can poll once instead of hitting /today and /tomorrow separately. The response is the same shape as /today: whether tomorrow is included is inferable from the 'end' timestamp. 'available' is true whenever any prices are known and false with an empty 'prices' array only when nothing is published — never an estimate. 'min/max/average' cover ALL currently-known prices, so the span widens as tomorrow publishes (~24h before, ~48h after) rather than being a stable daily figure. No 'expectedAt' hint is emitted here — that is /tomorrow's job. Published prices only — this is not a forecast.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "All currently-known published prices in a single list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PriceList" }
              }
            }
          },
          "404": {
            "description": "User settings not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/price/forecast": {
      "get": {
        "tags": ["Forecast"],
        "summary": "FI price forecast (estimate)",
        "description": "Returns a clearly-labelled price ESTIMATE for the days Nord Pool has not published yet, derived from public Fingrid grid data plus stored price history using simple closed-form math (no ML). Structurally distinct from the real-price endpoints — every money field is named `estimated*` and the response carries `forecast: true`. FI only; other areas return available:false. When data is insufficient the response is degraded/low-confidence rather than a confident guess.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "FI",
                "SE1",
                "SE2",
                "SE3",
                "SE4",
                "NO1",
                "NO2",
                "NO3",
                "NO4",
                "NO5",
                "DK1",
                "DK2",
                "EE",
                "LT",
                "LV",
                "AT",
                "BE",
                "FR",
                "GER",
                "NL",
                "PL"
              ],
              "default": "FI",
              "example": "FI",
              "description": "Delivery area. The forecast is FI-only; other areas return available:false."
            },
            "required": false,
            "description": "Delivery area. The forecast is FI-only; other areas return available:false.",
            "name": "area",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast estimate (check available/degraded/confidence). Non-FI areas return available:false.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForecastResponse" }
              }
            }
          },
          "404": {
            "description": "User settings not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForecastResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/settings": {
      "get": {
        "tags": ["User"],
        "summary": "Get user settings",
        "description": "Returns the authenticated user's electricity contract settings.",
        "responses": {
          "200": {
            "description": "Current user settings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserSettings" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["User"],
        "summary": "Update user settings",
        "description": "Update one or more electricity contract settings. Only provided fields are changed.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "marginCentsKwh": {
                    "type": "number",
                    "minimum": 0,
                    "example": 0.5
                  },
                  "transferDayCentsKwh": {
                    "type": "number",
                    "minimum": 0,
                    "example": 2.5
                  },
                  "transferNightCentsKwh": {
                    "type": "number",
                    "minimum": 0,
                    "example": 1.2
                  },
                  "taxCentsKwh": {
                    "type": "number",
                    "minimum": 0,
                    "example": 2.79372
                  },
                  "vatPercent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "example": 25.5,
                    "description": "VAT percentage (0-100)"
                  },
                  "nightStartHour": {
                    "type": "integer",
                    "minimum": 0,
