  "query": "\n        SELECT point_id, issued_at, target_time, temp, clouds, uvi, wind_speed, wind_deg\n        FROM weather_forecasts\n        WHERE point_id = $1 AND target_time >= $2 AND target_time < $3\n        ORDER BY target_time, issued_at\n        ",
