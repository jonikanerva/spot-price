# Copy to .env.local (not .env: the SQLx query macros read every .env file
# at compile time). The tests do not read this file. `mise run dev` sets
# DATABASE_URL to the dev server of the worktree (`mise run db:info`), and
# PORT and BETTER_AUTH_URL to the service port of the worktree; set both PORT
# and BETTER_AUTH_URL here to choose another address.
LOG_FORMAT=text

# Production (Railway sets PORT; DATABASE_URL is the direct Neon URL with
# sslmode=verify-full)
# NODE_ENV=production
# BETTER_AUTH_URL=https://spot.calmdonut.com
